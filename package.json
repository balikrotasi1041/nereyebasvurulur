{
  "name": "nereyebasvurulur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types:generate": "wrangler types --include-runtime false",
    "types:check": "wrangler types --include-runtime false --check",
    "check": "tsc --noEmit",
    "verify": "tsx scripts/verify-data.ts",
    "verify:petition": "tsx scripts/verify-petition.ts",
    "verify:quality": "tsx scripts/verify-quality-radar.ts",
    "audit:collisions": "tsx scripts/check-route-collisions.ts",
    "audit:risk": "tsx scripts/generate-risk-audit.ts",
    "audit:sources": "tsx scripts/check-source-links.ts",
    "refresh:military-branches": "node scripts/fetch-military-branches.mjs",
    "validate": "pnpm run types:check && pnpm run check && pnpm run verify && pnpm run verify:petition && pnpm run verify:quality && pnpm run audit:collisions && pnpm run cf:check",
    "cf:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
